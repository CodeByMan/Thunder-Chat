cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Build output
.next/
dist/
build/

# Environment files
.env
.env.*
!.env.example

# Runtime uploads
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/profiles/
!backend/uploads/profiles/.gitkeep
!backend/uploads/files/
!backend/uploads/files/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
EOF